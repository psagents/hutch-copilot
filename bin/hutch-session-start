#!/bin/bash
# SessionStart hook: announce the hutch context. At a hutch, ask for the experiment; off it,
# only tell the model, and only when bin/hutch-setup configured a hutch. Asking the operator in
# every S3DF session would be noise, so off-hutch nothing is shown to them.
set -u

host="$(hostname -s 2>/dev/null)" || exit 0
repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/.." && pwd)" || exit 0

case "$host" in
    *-daq|*-control) hutch="${host%-*}" ;;
    *)
        # The passwd home, not $HOME: a Cogito host sets $HOME to its overlay.
        hutch="$(cat "${HUTCH_SETUP_FILE:-$(getent passwd "${USER:-}" | cut -d: -f6)/.config/hutch-copilot/hutch}" 2>/dev/null)"
        [ -n "$hutch" ] || exit 0
        jq -n --arg ctx "hutch-copilot is set up for ${hutch^^} here ($host, off the hutch): \
everything only the hutch can read goes through the hutch-$hutch MCP server, and the tools \
are in $repo/bin. If this session turns to hutch work, ask which experiment first." \
            '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $ctx}}'
        exit 0 ;;
esac

context="$(cat <<EOF
HUTCH CONTEXT: $host (hutch=$hutch)

The hutch-copilot skill and its tools are installed at:
  $repo
Put the tools on PATH with: source $repo/bin/hutch-env
Use the hutch-copilot skill for any experiment operation at this hutch.

The hutch is known; the experiment is not, and the host cannot tell you. The
systemMessage has already asked the operator which experiment this session is for.
If they have not answered yet, ask again in your first reply and do not guess.
Once you have it, load its state with
  bin/hutch-state audit --hutch $hutch --experiment <experiment>
This applies to ANY hutch work in this session, not only an explicit
hutch-copilot dispatch.
EOF
)"

case "$host" in
    *-control)
        context="$context
NOTE: $host has no Slurm controller, so DAQ state is not visible here. The tools are designed for ${hutch}-daq."
        ;;
esac

# systemMessage is the only channel the operator actually sees; additionalContext
# is for the model. jq builds the JSON so hostnames and paths cannot break it.
jq -n --arg ctx "$context" \
    --arg msg "hutch-copilot is ready to help you at ${hutch^^} ($host). Which experiment is this session for?" \
    '{systemMessage: $msg, hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $ctx}}' \
    || printf '%s\n' "$context"

exit 0
