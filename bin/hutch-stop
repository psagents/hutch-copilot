#!/bin/bash
# Stop hook: ask the agent to sync the beamtime log, when the turn earned it.
#
# Decides *whether to ask*, never what to log -- that judgment is sync-log/SKILL.md,
# and it runs in the session that still has the context. This hook spawns nothing.
#
# Every failure path is `exit 0` with no output. A bookkeeping hook that can wedge a
# shift is worse than no bookkeeping.
#
# The payload shape below is read from the shipping CLI, not a published API:
# {session_id, transcript_path, cwd, hook_event_name, stop_hook_active,
#  last_assistant_message, ...}. Re-verify after a CLI upgrade.
set -u

payload="$(cat)" || exit 0
[ -n "$payload" ] || exit 0

field() { printf '%s' "$payload" | jq -r "${1} // empty" 2>/dev/null; }

# Guard 1 of 4: true on the Stop that follows our own block. The CLI's own
# guidance. Guard 2 is the harness -- CLAUDE_CODE_STOP_HOOK_BLOCK_CAP, default 8
# consecutive blocks before it overrides us. Guard 3 is the watermark advancing
# (sync-log writes it). Guard 4 is that this script calls no tool and spawns no agent.
[ "$(field .stop_hook_active)" = "true" ] && exit 0

# Same narrow guard as bin/hutch-session-start, for the same reason: off-hutch the
# tools cannot reach /cds, so asking for a log entry there is noise, not bookkeeping.
host="$(hostname -s 2>/dev/null)" || exit 0
case "$host" in
    *-daq|*-control) hutch="${host%-*}" ;;
    *) exit 0 ;;
esac

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/.." && pwd)" || exit 0

# Developing the copilot is not operating the hutch. Without this, writing
# `--experiment mfx101609126` into a test fixture reads exactly like running it
# against the DAQ, and the shift log gets an entry attributed to a unit test.
cwd="$(field .cwd)"
case "${cwd%/}/" in
    "$repo"/*) exit 0 ;;
esac

transcript="$(field .transcript_path)"
[ -n "$transcript" ] && [ -r "$transcript" ] || exit 0

# Never guess an experiment (SKILL.md: a value without provenance cannot be told
# apart from a guess). grep -o | tail -1 so the file -- megabytes by end of shift --
# is never held in memory.
experiment="$(grep -oE -- '--experiment[ =]+[a-z]+[0-9]+' "$transcript" 2>/dev/null \
              | tail -1 | grep -oE '[a-z]+[0-9]+$')"
[ -n "$experiment" ] || exit 0

# Did this turn touch the experiment at all? Deliberately coarse: a filter, not
# judgment. last_assistant_message is in the payload, so the common case needs no
# transcript read at all.
touched='hutch-(state|daq|data|lute|log|epics|happi|lightpath|python)|\brun [0-9]+'
printf '%s' "$(field .last_assistant_message)" | grep -qE "$touched" || exit 0

reason="Before this turn ends, sync the beamtime log for $experiment.

Read $repo/sync-log/SKILL.md and follow it: record what this turn established in
the beamtime log (events) and the state file (facts, with provenance), then advance
the watermark. Hutch is $hutch, experiment is $experiment.

If nothing in this turn is worth recording, say so in one line and stop -- an empty
entry is worse than none."

# reason -> the model (it acts on this); systemMessage -> the operator (so a paused
# turn is explained rather than mysterious). jq builds the JSON so an experiment
# name or path can never break it.
jq -n --arg r "$reason" --arg m "hutch-copilot: syncing the beamtime log for $experiment" \
    '{decision: "block", reason: $r, systemMessage: $m}' || exit 0

exit 0
