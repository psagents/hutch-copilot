# shellcheck shell=bash
# Source me: `source bin/hutch-env`. Sets up a shell to run the hutch tools.
#
# Not executable and has no shebang on purpose -- a subshell that exported
# these would exit and take them with it.
#
# PYTHONPATH is deliberately NOT set: every bin/hutch-* inserts the repo root
# on sys.path itself, so the tools already work from a bare checkout and an
# export here would only be a second way to get it wrong.
#
# EPICS_CA_ADDR_LIST is deliberately NOT set either. It is unset on the DAQ
# machines and Channel Access works by broadcast; pinning it would be a guess
# that can break a working path.

_hutch_env_repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

# The hutch comes from the hostname -- this skill serves MEC, MFX, RIX, TMO and
# XPP
hutch_from_hostname() {
    case "${1:-$(hostname -s)}" in
        *-daq|*-control|*-console|*-monitor)
            printf '%s\n' "${1:-$(hostname -s)}" | sed -E 's/-(daq|control|console|monitor)$//' ;;
        *) return 1 ;;
    esac
}

# --------------------------------------------------------------------------
# External paths -- the single source of truth for every path outside this repo
# --------------------------------------------------------------------------

# EPICS Channel Access binaries (caget). The rhel9 build: a linux-x86_64 path is
# wrong on these hosts, and the old extensions path exists on neither.
export HUTCH_EPICS_BIN="${HUTCH_EPICS_BIN:-/cds/group/pcds/epics/base/R7.0.2-2.0/bin/rhel9-x86_64}"

# happi device database, and the hutch-python app tree beside it.
export HUTCH_HAPPI_DB="${HUTCH_HAPPI_DB:-/cds/group/pcds/pyps/apps/hutch-python/device_config/db.json}"
export HUTCH_PYTHON_APPS="${HUTCH_PYTHON_APPS:-/cds/group/pcds/pyps/apps/hutch-python}"

# Interpreters. PCDS_PYTHON runs lightpath/happi; the psconda script and the two
# LUTE interpreters are the analysis side.
export HUTCH_PCDS_PYTHON="${HUTCH_PCDS_PYTHON:-/cds/group/pcds/pyps/conda/py312/envs/pcds-6.1.0/bin/python3.12}"
export HUTCH_PSCONDA="${HUTCH_PSCONDA:-/sdf/group/lcls/ds/ana/sw/conda2/manage/bin/psconda.sh}"
export HUTCH_LUTE_PY39="${HUTCH_LUTE_PY39:-/sdf/group/lcls/ds/ana/sw/conda2/inst/bin/python3.9}"
export HUTCH_LUTE_PY311="${HUTCH_LUTE_PY311:-/sdf/group/lcls/ds/ana/sw/conda2-v3/inst/bin/python3.11}"

# The operator log root is joined with <hutch>opr/YYYY/MM.
export HUTCH_OPR_LOG_ROOT="${HUTCH_OPR_LOG_ROOT:-/cds/home/opr}"

# EPICS Archiver Appliance retrieval root, for PV history. Hutch network only.
# getData.json works; getAllPVs and getApplianceInfo both 404, so "is this PV
# archived" can only be learned from a per-PV 404.
export HUTCH_ARCHIVER_URL="${HUTCH_ARCHIVER_URL:-http://pscaa01.slac.stanford.edu:17668/retrieval}"

# DAQ config dir carries a {hutch} field, filled in by the caller.
if [ -z "${HUTCH_DAQ_CONFIG_DIR:-}" ]; then
    export HUTCH_DAQ_CONFIG_DIR='/cds/group/pcds/dist/pds/{hutch}/scripts'
fi

# LCLS data filesystem, and the skill roots (colon-separated, ~ allowed).
export HUTCH_DS_ROOT="${HUTCH_DS_ROOT:-/sdf/data/lcls/ds}"
export HUTCH_SKILL_ROOTS="${HUTCH_SKILL_ROOTS:-~/.claude/skills:/sdf/group/lcls/ds/dm/apps/dev/opencode/skills}"

# EPICS Channel Access binaries (caget). Prepend the build path if caget is not on PATH.
if ! command -v caget >/dev/null 2>&1 && [ -x "$HUTCH_EPICS_BIN/caget" ]; then
    PATH="$HUTCH_EPICS_BIN:$PATH"
fi

case ":$PATH:" in
    *":$_hutch_env_repo/bin:"*) ;;
    *) PATH="$_hutch_env_repo/bin:$PATH" ;;
esac
export PATH

if HUTCH="$(hutch_from_hostname)"; then
    export HUTCH
    echo "hutch-env: HUTCH=$HUTCH, tools on PATH from $_hutch_env_repo/bin"
else
    echo "hutch-env: $(hostname -s) is not a hutch machine -- tools are on PATH," \
         "but anything reading /cds, CA or the DAQ logs will fail here." >&2
fi

# Only the internals. Every HUTCH_* path above must survive into the environment.
unset _hutch_env_repo
